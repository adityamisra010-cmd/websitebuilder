{%- assign variant = section.settings.hero_variant -%}

{%- if variant == 'split' -%}

<section class="vc-sec vc-heroA">
  <div class="vc-wrap">
    <div class="vc-heroA__grid">
      <div class="vc-heroA__copy">
        {%- if section.settings.eyebrow != blank -%}
          <span class="vc-eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h1 class="vc-heroA__h">{{ section.settings.heading }}</h1>
        {%- if section.settings.subtext != blank -%}
          <p class="vc-heroA__sub">{{ section.settings.subtext }}</p>
        {%- endif -%}
        <div class="vc-heroA__actions">
          {%- if section.settings.cta_primary_label != blank -%}
            <a href="{{ section.settings.cta_primary_url }}" class="vc-btn vc-btn--primary">
              {{ section.settings.cta_primary_label }}
              <span class="vc-btn__arrow" aria-hidden="true">→</span>
            </a>
          {%- endif -%}
          {%- if section.settings.cta_secondary_label != blank -%}
            <a href="{{ section.settings.cta_secondary_url }}" class="vc-btn vc-btn--secondary">
              {{ section.settings.cta_secondary_label }}
            </a>
          {%- endif -%}
        </div>
        {%- if section.settings.reassure_text != blank -%}
          <p class="vc-heroA__reassure">{{ section.settings.reassure_text }}</p>
        {%- endif -%}
      </div>

      <div class="vc-heroA__media">
        {%- if section.settings.image != blank -%}
          <img
            src="{{ section.settings.image | image_url: width: 900 }}"
            srcset="{{ section.settings.image | image_url: width: 600 }} 600w,
                    {{ section.settings.image | image_url: width: 900 }} 900w"
            sizes="(min-width: 990px) 50vw, 100vw"
            alt="{{ section.settings.image.alt | escape }}"
            class="vc-heroA__img"
            loading="eager"
            fetchpriority="high"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
          >
        {%- else -%}
          <div class="vc-heroA__img" style="background-color:var(--vc-warm-panel);"></div>
        {%- endif -%}

        {%- if section.settings.badge_text != blank -%}
          <div class="vc-heroA__badge" aria-hidden="true">
            <div class="vc-heroA__badge-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
            </div>
            <span>{{ section.settings.badge_text }}</span>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{%- else -%}

<section class="vc-sec vc-heroB">
  {%- if section.settings.image != blank -%}
    <img
      src="{{ section.settings.image | image_url: width: 1600 }}"
      srcset="{{ section.settings.image | image_url: width: 800 }} 800w,
              {{ section.settings.image | image_url: width: 1200 }} 1200w,
              {{ section.settings.image | image_url: width: 1600 }} 1600w"
      sizes="100vw"
      alt="{{ section.settings.image.alt | escape }}"
      class="vc-heroB__bg"
      loading="eager"
      fetchpriority="high"
      width="{{ section.settings.image.width }}"
      height="{{ section.settings.image.height }}"
    >
  {%- else -%}
    <div class="vc-heroB__bg" style="background-color:var(--vc-ink);"></div>
  {%- endif -%}

  <div class="vc-heroB__scrim" aria-hidden="true"></div>

  <div class="vc-wrap" style="width:100%;position:relative;z-index:1;">
    <div class="vc-heroB__content">
      {%- if section.settings.eyebrow != blank -%}
        <span class="vc-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h1 class="vc-heroB__h">{{ section.settings.heading }}</h1>
      {%- if section.settings.subtext != blank -%}
        <p class="vc-heroB__sub">{{ section.settings.subtext }}</p>
      {%- endif -%}
      <div class="vc-heroB__actions">
        {%- if section.settings.cta_primary_label != blank -%}
          <a href="{{ section.settings.cta_primary_url }}" class="vc-btn vc-btn--primary">
            {{ section.settings.cta_primary_label }}
            <span class="vc-btn__arrow" aria-hidden="true">→</span>
          </a>
        {%- endif -%}
        {%- if section.settings.cta_secondary_label != blank -%}
          <a href="{{ section.settings.cta_secondary_url }}" class="vc-btn vc-btn--secondary">
            {{ section.settings.cta_secondary_label }}
          </a>
        {%- endif -%}
      </div>
      {%- if section.settings.reassure_text != blank -%}
        <p class="vc-heroB__reassure">{{ section.settings.reassure_text }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{%- endif -%}

{% schema %}
{
  "name": "VC Hero",
  "tag": "section",
  "class": "vc-sec",
  "settings": [
    {
      "type": "select",
      "id": "hero_variant",
      "label": "Hero style",
      "default": "split",
      "options": [
        { "value": "split",    "label": "Editorial split (Hero A)" },
        { "value": "fullbleed","label": "Full-bleed immersive (Hero B)" }
      ]
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "Premium Cordyceps"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Energy That Starts From Within"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Clinically-studied Cordyceps militaris — grown in India, tested for purity, and formulated to fuel your best days."
    },
    {
      "type": "text",
      "id": "reassure_text",
      "label": "Reassurance micro-copy",
      "default": "No subscription required · 30-day returns"
    },
    {
      "type": "header",
      "content": "Primary CTA"
    },
    {
      "type": "text",
      "id": "cta_primary_label",
      "label": "Button label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "cta_primary_url",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Secondary CTA"
    },
    {
      "type": "text",
      "id": "cta_secondary_label",
      "label": "Button label",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "cta_secondary_url",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Floating Badge (split variant only)"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "4.9★ · 2,000+ reviews"
    }
  ],
  "presets": [
    {
      "name": "VC Hero — Split",
      "settings": {
        "hero_variant": "split",
        "eyebrow": "Premium Cordyceps",
        "heading": "Energy That Starts From Within",
        "subtext": "Clinically-studied Cordyceps militaris — grown in India, tested for purity, and formulated to fuel your best days.",
        "cta_primary_label": "Shop Now",
        "cta_secondary_label": "Our Story",
        "badge_text": "4.9★ · 2,000+ reviews"
      }
    },
    {
      "name": "VC Hero — Full Bleed",
      "settings": {
        "hero_variant": "fullbleed",
        "eyebrow": "Premium Cordyceps",
        "heading": "Unlock Your Natural Energy",
        "subtext": "The mushroom trusted by athletes and wellness seekers across India.",
        "cta_primary_label": "Shop Now",
        "cta_secondary_label": "Learn More"
      }
    }
  ]
}
{% endschema %}
