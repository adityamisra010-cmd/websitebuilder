<section class="vc-sec vc-sec--paper vc-sec__pad">
  <div class="vc-wrap">
    <div class="vc-sec-head--center">
      {%- if section.settings.eyebrow != blank -%}
        <span class="vc-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2 class="vc-h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.subtext != blank -%}
        <p class="vc-sec-sub">{{ section.settings.subtext }}</p>
      {%- endif -%}
    </div>

    <div class="vc-faq">
      {%- for block in section.blocks -%}
        <details class="vc-faqi" {{ block.shopify_attributes }}>
          <summary>
            {{ block.settings.question }}
            <span class="vc-faqi__icon" aria-hidden="true">+</span>
          </summary>
          <div class="vc-faqi__a">
            {{ block.settings.answer }}
          </div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "VC FAQ",
  "tag": "section",
  "class": "vc-sec",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "FAQ"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Common Questions"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "FAQ item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What is Cordyceps militaris?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Cordyceps militaris is a medicinal mushroom with a long history in Traditional Chinese Medicine, now supported by modern clinical research for its effects on energy, endurance, and immune function.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "VC FAQ",
      "settings": {
        "eyebrow": "FAQ",
        "heading": "Common Questions"
      },
      "blocks": [
        {
          "type": "item",
          "settings": {
            "question": "What is Cordyceps militaris and why does it matter?",
            "answer": "<p>Cordyceps militaris is a medicinal mushroom backed by clinical research for improved energy production, VO₂ max, and immune resilience. Unlike synthetic stimulants, it works with your body's natural pathways.</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "question": "How long until I notice results?",
            "answer": "<p>Most customers report noticeable improvements in energy and focus within 1–2 weeks of consistent daily use. Full adaptogenic benefits typically build over 4–6 weeks.</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "question": "Are there any side effects?",
            "answer": "<p>Cordyceps is well-tolerated for most healthy adults. As with any supplement, consult your doctor if you are pregnant, nursing, or on medication. Start with the recommended dose and increase gradually.</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "question": "What is your return policy?",
            "answer": "<p>We offer a 30-day satisfaction guarantee. If you're not happy for any reason, contact us at support@vitalcep.com and we'll make it right — no questions asked.</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "question": "Is Vitalcep vegan and allergen-free?",
            "answer": "<p>Yes. All Vitalcep products are 100% vegan, gluten-free, and free from common allergens. We never use fillers, binders, or artificial colours.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
